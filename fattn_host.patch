 // Best FlashAttention kernel for a specific GPU:
+// STATOR: whether the KV cache is host memory that the GPU reads through the
+// host page tables (pageable or registered), as with GGML_CUDA_HOST_PTR.
+static bool ggml_cuda_fattn_kv_in_host_memory(const ggml_tensor * K) {
+    cudaPointerAttributes attr;
+    if (cudaPointerGetAttributes(&attr, K->data) != cudaSuccess) {
+        (void) cudaGetLastError();
+        return false;
+    }
+    return attr.type == cudaMemoryTypeUnregistered || attr.type == cudaMemoryTypeHost;
+}
+
+// STATOR: with the cache in host memory, a decoding step reads each row of the
+// cache once per group of query heads in the MMA kernel and once per query head
+// in the vector kernel, and a read of host memory costs more than a read of
+// device memory. GGML_CUDA_FATTN_HOST_GQA=0 restores the choice of upstream,
+// and GGML_CUDA_FATTN_HOST_GQA=2 groups the query heads for a cache anywhere
+// (to give a baseline in device memory the same choice).
+static bool ggml_cuda_fattn_group_host_kv(const ggml_tensor * K, const bool gqa_opt_applies) {
+    static const int mode = [] {
+        const char * value = getenv("GGML_CUDA_FATTN_HOST_GQA");
+        return value == nullptr ? 1 : atoi(value);
+    }();
+    if (mode == 0 || !gqa_opt_applies) {
+        return false;
+    }
+    return mode == 2 || ggml_cuda_fattn_kv_in_host_memory(K);
+}
