+#if defined(GGML_USE_VMM) && !defined(GGML_USE_HIP)
+// Device memory composed from physical allocations of this process and of another one.
+// A range is reserved once; allocations are mapped into it, new ones or ones another process exported.
+extern "C" {
+GGML_BACKEND_API void * ggml_backend_cuda_vmm_reserve(int device, size_t size);
+GGML_BACKEND_API bool ggml_backend_cuda_vmm_map_new(int device, void * addr, size_t size, int * fd);
+GGML_BACKEND_API bool ggml_backend_cuda_vmm_map_fd(int device, void * addr, size_t size, int fd);
+GGML_BACKEND_API bool ggml_backend_cuda_vmm_copy_fd(int device, void * dst, size_t size, int fd, size_t bytes);
+GGML_BACKEND_API bool ggml_backend_cuda_vmm_protect(int device, void * addr, size_t size);
+GGML_BACKEND_API void ggml_backend_cuda_vmm_zero(int device, void * addr, size_t size);
+GGML_BACKEND_API ggml_backend_buffer_t ggml_backend_cuda_vmm_buffer(int device, void * base, size_t size);
+// The same steps for many allocations at once: one access setting for a range, and one wait for the device.
+GGML_BACKEND_API bool ggml_backend_cuda_vmm_map_fds(int device, void * addr, size_t size, const int * fds, size_t count);
+GGML_BACKEND_API bool ggml_backend_cuda_vmm_map_private(int device, void * addr, size_t size);
+GGML_BACKEND_API bool ggml_backend_cuda_vmm_copy_fds(int device, void * const * dsts, size_t size, const int * fds, const size_t * bytes, size_t count);
+GGML_BACKEND_API bool ggml_backend_cuda_vmm_protect_ranges(int device, void * const * addrs, const size_t * sizes, size_t count);
+GGML_BACKEND_API void ggml_backend_cuda_vmm_wait(int device);
+GGML_BACKEND_API void ggml_backend_cuda_vmm_zero_ranges(int device, void * const * addrs, const size_t * sizes, size_t count);
+GGML_BACKEND_API bool ggml_backend_cuda_vmm_merge(int device, void * const * addrs, const size_t * counts, size_t ranges, size_t size, int * fds);
+}
+
+static bool ggml_cuda_vmm_ok(CUresult err, const char * what) {
+    if (err != CUDA_SUCCESS) {
+        GGML_LOG_ERROR("%s: %s failed: %s\n", __func__, what, cu_get_error_str(err));
+        return false;
+    }
+    return true;
+}
+
+static bool ggml_cuda_vmm_access(int device, CUdeviceptr addr, size_t size, CUmemAccess_flags flags) {
+    CUmemAccessDesc access = {};
+    access.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+    access.location.id = ggml_cuda_get_physical_device(device);
+    access.flags = flags;
+    return ggml_cuda_vmm_ok(cuMemSetAccess(addr, size, &access, 1), "cuMemSetAccess");
+}
+
+void * ggml_backend_cuda_vmm_reserve(int device, size_t size) {
+    ggml_cuda_set_device(device);
+    CUdeviceptr addr = 0;
+    if (!ggml_cuda_vmm_ok(cuMemAddressReserve(&addr, size, 0, 0, 0), "cuMemAddressReserve")) {
+        return nullptr;
+    }
+    return (void *) addr;
+}
+
+// Maps a new allocation, zeroed. With fd != nullptr the allocation can be shared, and *fd is its handle.
+bool ggml_backend_cuda_vmm_map_new(int device, void * addr, size_t size, int * fd) {
+    ggml_cuda_set_device(device);
+    CUmemAllocationProp prop = {};
+    prop.type = CU_MEM_ALLOCATION_TYPE_PINNED;
+    prop.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+    prop.location.id = ggml_cuda_get_physical_device(device);
+    if (fd != nullptr) {
+        prop.requestedHandleTypes = CU_MEM_HANDLE_TYPE_POSIX_FILE_DESCRIPTOR;
+    }
+    CUmemGenericAllocationHandle handle;
+    if (!ggml_cuda_vmm_ok(cuMemCreate(&handle, size, &prop, 0), "cuMemCreate")) {
+        return false;
+    }
+    bool ok = ggml_cuda_vmm_ok(cuMemMap((CUdeviceptr) addr, size, 0, handle, 0), "cuMemMap") &&
+              ggml_cuda_vmm_access(device, (CUdeviceptr) addr, size, CU_MEM_ACCESS_FLAGS_PROT_READWRITE);
+    if (ok && fd != nullptr) {
+        ok = ggml_cuda_vmm_ok(cuMemExportToShareableHandle(fd, handle, CU_MEM_HANDLE_TYPE_POSIX_FILE_DESCRIPTOR, 0), "cuMemExportToShareableHandle");
+    }
+    CU_CHECK(cuMemRelease(handle));
+    if (ok) {
+        CUDA_CHECK(cudaMemset(addr, 0, size));
+    }
+    return ok;
+}
+
+// Maps an allocation that another process exported, read-only.
+bool ggml_backend_cuda_vmm_map_fd(int device, void * addr, size_t size, int fd) {
+    ggml_cuda_set_device(device);
+    CUmemGenericAllocationHandle handle;
+    if (!ggml_cuda_vmm_ok(cuMemImportFromShareableHandle(&handle, (void *) (uintptr_t) fd, CU_MEM_HANDLE_TYPE_POSIX_FILE_DESCRIPTOR), "cuMemImportFromShareableHandle")) {
+        return false;
+    }
+    const bool ok = ggml_cuda_vmm_ok(cuMemMap((CUdeviceptr) addr, size, 0, handle, 0), "cuMemMap") &&
+                    ggml_cuda_vmm_access(device, (CUdeviceptr) addr, size, CU_MEM_ACCESS_FLAGS_PROT_READ);
+    CU_CHECK(cuMemRelease(handle));
+    return ok;
+}
+
+// Copies the first bytes of an exported allocation of `size` bytes to dst.
+bool ggml_backend_cuda_vmm_copy_fd(int device, void * dst, size_t size, int fd, size_t bytes) {
+    ggml_cuda_set_device(device);
+    CUdeviceptr tmp = 0;
+    if (!ggml_cuda_vmm_ok(cuMemAddressReserve(&tmp, size, 0, 0, 0), "cuMemAddressReserve")) {
+        return false;
+    }
+    bool ok = ggml_backend_cuda_vmm_map_fd(device, (void *) tmp, size, fd);
+    if (ok) {
+        // a copy between device ranges returns before it is done; the source is unmapped only after it
+        ok = ggml_cuda_vmm_ok(cuMemcpy((CUdeviceptr) dst, tmp, bytes), "cuMemcpy") &&
+             ggml_cuda_vmm_ok(cuCtxSynchronize(), "cuCtxSynchronize");
+        CU_CHECK(cuMemUnmap(tmp, size));
+    }
+    CU_CHECK(cuMemAddressFree(tmp, size));
+    return ok;
+}
+
+bool ggml_backend_cuda_vmm_protect(int device, void * addr, size_t size) {
+    ggml_cuda_set_device(device);
+    CUDA_CHECK(cudaDeviceSynchronize());
+    return ggml_cuda_vmm_access(device, (CUdeviceptr) addr, size, CU_MEM_ACCESS_FLAGS_PROT_READ);
+}
+
+void ggml_backend_cuda_vmm_zero(int device, void * addr, size_t size) {
+    ggml_cuda_set_device(device);
+    CUDA_CHECK(cudaDeviceSynchronize());
+    CUDA_CHECK(cudaMemset(addr, 0, size));
+}
+
+// Where the time of mapping exported allocations goes, in ms: importing the handles, mapping them, setting the access.
+static double ggml_cuda_vmm_map_ms[3] = { 0.0, 0.0, 0.0 };
+
+static double ggml_cuda_vmm_ms_since(std::chrono::steady_clock::time_point from) {
+    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - from).count();
+}
+
+// Maps `count` allocations of `size` bytes that another process exported, one after the other from addr, read-only.
+bool ggml_backend_cuda_vmm_map_fds(int device, void * addr, size_t size, const int * fds, size_t count) {
+    ggml_cuda_set_device(device);
+    for (size_t i = 0; i < count; ++i) {
+        CUmemGenericAllocationHandle handle;
+        auto mark = std::chrono::steady_clock::now();
+        if (!ggml_cuda_vmm_ok(cuMemImportFromShareableHandle(&handle, (void *) (uintptr_t) fds[i], CU_MEM_HANDLE_TYPE_POSIX_FILE_DESCRIPTOR), "cuMemImportFromShareableHandle")) {
+            return false;
+        }
+        ggml_cuda_vmm_map_ms[0] += ggml_cuda_vmm_ms_since(mark);
+        mark = std::chrono::steady_clock::now();
+        const bool ok = ggml_cuda_vmm_ok(cuMemMap((CUdeviceptr) addr + i * size, size, 0, handle, 0), "cuMemMap");
+        CU_CHECK(cuMemRelease(handle));
+        ggml_cuda_vmm_map_ms[1] += ggml_cuda_vmm_ms_since(mark);
+        if (!ok) {
+            return false;
+        }
+    }
+    const auto mark = std::chrono::steady_clock::now();
+    const bool ok = count == 0 || ggml_cuda_vmm_access(device, (CUdeviceptr) addr, count * size, CU_MEM_ACCESS_FLAGS_PROT_READ);
+    ggml_cuda_vmm_map_ms[2] += ggml_cuda_vmm_ms_since(mark);
+    return ok;
+}
+
+// Maps one new allocation of `size` bytes that only this process uses, zeroed. The zeroing is not waited for.
+bool ggml_backend_cuda_vmm_map_private(int device, void * addr, size_t size) {
+    ggml_cuda_set_device(device);
+    CUmemAllocationProp prop = {};
+    prop.type = CU_MEM_ALLOCATION_TYPE_PINNED;
+    prop.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+    prop.location.id = ggml_cuda_get_physical_device(device);
+    CUmemGenericAllocationHandle handle;
+    if (!ggml_cuda_vmm_ok(cuMemCreate(&handle, size, &prop, 0), "cuMemCreate")) {
+        return false;
+    }
+    const bool ok = ggml_cuda_vmm_ok(cuMemMap((CUdeviceptr) addr, size, 0, handle, 0), "cuMemMap") &&
+                    ggml_cuda_vmm_access(device, (CUdeviceptr) addr, size, CU_MEM_ACCESS_FLAGS_PROT_READWRITE);
+    CU_CHECK(cuMemRelease(handle));
+    if (ok) {
+        CUDA_CHECK(cudaMemsetAsync(addr, 0, size, cudaStreamPerThread));
+    }
+    return ok;
+}
+
+// Copies the first bytes[i] of exported allocation i, of `size` bytes, to dsts[i], and waits once for all copies.
+bool ggml_backend_cuda_vmm_copy_fds(int device, void * const * dsts, size_t size, const int * fds, const size_t * bytes, size_t count) {
+    if (count == 0) {
+        return true;
+    }
+    ggml_cuda_set_device(device);
+    CUdeviceptr tmp = 0;
+    if (!ggml_cuda_vmm_ok(cuMemAddressReserve(&tmp, count * size, 0, 0, 0), "cuMemAddressReserve")) {
+        return false;
+    }
+    size_t mapped = 0;
+    bool ok = true;
+    for (; ok && mapped < count; ++mapped) {
+        CUmemGenericAllocationHandle handle;
+        ok = ggml_cuda_vmm_ok(cuMemImportFromShareableHandle(&handle, (void *) (uintptr_t) fds[mapped], CU_MEM_HANDLE_TYPE_POSIX_FILE_DESCRIPTOR), "cuMemImportFromShareableHandle");
+        if (!ok) {
+            break;
+        }
+        ok = ggml_cuda_vmm_ok(cuMemMap(tmp + mapped * size, size, 0, handle, 0), "cuMemMap");
+        CU_CHECK(cuMemRelease(handle));
+        if (!ok) {
+            break;
+        }
+    }
+    ok = ok && ggml_cuda_vmm_access(device, tmp, count * size, CU_MEM_ACCESS_FLAGS_PROT_READ);
+    if (ok) {
+        // the copies run in the stream of the zeroing of their destinations, after it
+        for (size_t i = 0; ok && i < count; ++i) {
+            ok = cudaMemcpyAsync(dsts[i], (const void *) (tmp + i * size), bytes[i], cudaMemcpyDeviceToDevice, cudaStreamPerThread) == cudaSuccess;
+        }
+        // the sources are unmapped only after the copies are done
+        ok = (cudaStreamSynchronize(cudaStreamPerThread) == cudaSuccess) && ok;
+    }
+    for (size_t i = 0; i < mapped; ++i) {
+        CU_CHECK(cuMemUnmap(tmp + i * size, size));
+    }
+    CU_CHECK(cuMemAddressFree(tmp, count * size));
+    GGML_LOG_WARN("%s: exported allocations so far: import %.1f ms, map %.1f ms, access %.1f ms\n", __func__,
+            ggml_cuda_vmm_map_ms[0], ggml_cuda_vmm_map_ms[1], ggml_cuda_vmm_map_ms[2]);
+    return ok;
+}
+
+// Waits for the zeroing of the allocations that this thread mapped.
+void ggml_backend_cuda_vmm_wait(int device) {
+    ggml_cuda_set_device(device);
+    CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
+}
+
+// Replaces, in every range, the counts[i] allocations of `size` bytes that are mapped from addrs[i] by one allocation
+// with the same contents, mapped read-only; fds[i] is its handle, or -1 for an empty range. An allocation cannot be
+// extended or joined with another one, so the contents are copied, with one wait for the device for all ranges.
+bool ggml_backend_cuda_vmm_merge(int device, void * const * addrs, const size_t * counts, size_t ranges, size_t size, int * fds) {
+    ggml_cuda_set_device(device);
+    CUDA_CHECK(cudaDeviceSynchronize());
+    CUmemAllocationProp prop = {};
+    prop.type = CU_MEM_ALLOCATION_TYPE_PINNED;
+    prop.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+    prop.location.id = ggml_cuda_get_physical_device(device);
+    prop.requestedHandleTypes = CU_MEM_HANDLE_TYPE_POSIX_FILE_DESCRIPTOR;
+    std::vector<CUmemGenericAllocationHandle> handles(ranges);
+    std::vector<CUdeviceptr> tmps(ranges, 0);
+    bool ok = true;
+    for (size_t i = 0; ok && i < ranges; ++i) {
+        fds[i] = -1;
+        const size_t bytes = counts[i] * size;
+        if (bytes == 0) {
+            continue;
+        }
+        ok = ggml_cuda_vmm_ok(cuMemCreate(&handles[i], bytes, &prop, 0), "cuMemCreate") &&
+             ggml_cuda_vmm_ok(cuMemAddressReserve(&tmps[i], bytes, 0, 0, 0), "cuMemAddressReserve") &&
+             ggml_cuda_vmm_ok(cuMemMap(tmps[i], bytes, 0, handles[i], 0), "cuMemMap") &&
+             ggml_cuda_vmm_access(device, tmps[i], bytes, CU_MEM_ACCESS_FLAGS_PROT_READWRITE) &&
+             cudaMemcpyAsync((void *) tmps[i], addrs[i], bytes, cudaMemcpyDeviceToDevice, cudaStreamPerThread) == cudaSuccess;
+    }
+    ok = (cudaStreamSynchronize(cudaStreamPerThread) == cudaSuccess) && ok;
+    for (size_t i = 0; ok && i < ranges; ++i) {
+        const size_t bytes = counts[i] * size;
+        if (bytes == 0) {
+            continue;
+        }
+        for (size_t g = 0; g < counts[i]; ++g) {
+            CU_CHECK(cuMemUnmap((CUdeviceptr) addrs[i] + g * size, size));
+        }
+        CU_CHECK(cuMemUnmap(tmps[i], bytes));
+        CU_CHECK(cuMemAddressFree(tmps[i], bytes));
+        ok = ggml_cuda_vmm_ok(cuMemMap((CUdeviceptr) addrs[i], bytes, 0, handles[i], 0), "cuMemMap") &&
+             ggml_cuda_vmm_access(device, (CUdeviceptr) addrs[i], bytes, CU_MEM_ACCESS_FLAGS_PROT_READ) &&
+             ggml_cuda_vmm_ok(cuMemExportToShareableHandle(&fds[i], handles[i], CU_MEM_HANDLE_TYPE_POSIX_FILE_DESCRIPTOR, 0), "cuMemExportToShareableHandle");
+        CU_CHECK(cuMemRelease(handles[i]));
+    }
+    return ok;
+}
+
+// Zeroes ranges with one wait for the device before and one after.
+void ggml_backend_cuda_vmm_zero_ranges(int device, void * const * addrs, const size_t * sizes, size_t count) {
+    ggml_cuda_set_device(device);
+    CUDA_CHECK(cudaDeviceSynchronize());
+    for (size_t i = 0; i < count; ++i) {
+        if (sizes[i] > 0) {
+            CUDA_CHECK(cudaMemsetAsync(addrs[i], 0, sizes[i], cudaStreamPerThread));
+        }
+    }
+    CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
+}
+
+// Makes ranges read-only after one wait for the device.
+bool ggml_backend_cuda_vmm_protect_ranges(int device, void * const * addrs, const size_t * sizes, size_t count) {
+    ggml_cuda_set_device(device);
+    CUDA_CHECK(cudaDeviceSynchronize());
+    for (size_t i = 0; i < count; ++i) {
+        if (sizes[i] > 0 && !ggml_cuda_vmm_access(device, (CUdeviceptr) addrs[i], sizes[i], CU_MEM_ACCESS_FLAGS_PROT_READ)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+ggml_backend_buffer_t ggml_backend_cuda_vmm_buffer(int device, void * base, size_t size) {
+    ggml_backend_cuda_buffer_context * ctx = new ggml_backend_cuda_buffer_context(device, base);
+    ctx->external = true;
+    return ggml_backend_buffer_init(ggml_backend_cuda_buffer_type(device), ggml_backend_cuda_buffer_interface, ctx, size);
+}
+#endif // defined(GGML_USE_VMM) && !defined(GGML_USE_HIP)
