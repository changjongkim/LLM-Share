+
+// The key-value cache in pageable host memory that the GPU uses in place, on
+// a device that accepts host pointers as buffers (GGML_CUDA_HOST_PTR).
+//
+//   LLAMA_KV_HOST=anon     private anonymous memory.
+//   LLAMA_KV_HOST=<path>   a file holds the cache. Without LLAMA_KV_PREFIX
+//                          the process maps it shared and fills it. With
+//                          LLAMA_KV_PREFIX=<cells> the process maps the first
+//                          <cells> rows of every tensor read-only from the
+//                          file and everything else private: a prefix that
+//                          another process computed is shared without a copy
+//                          and without copy-on-write, and the process writes
+//                          its own rows after it.
+//
+// A kv cache in host memory that the device reads in place.
+struct llama_kv_host {
+    struct span {
+        size_t offset; // of the tensor in the mapping, a multiple of 2 MiB
+        size_t row;    // bytes of one row
+        size_t rows;
+        size_t size;   // bytes up to the next tensor
+    };
+    std::vector<span> tensors;
+    std::string path;       // file with the rows of the publisher
+    char * base = nullptr;
+    size_t rows_mapped = 0; // leading rows taken from the file, never written
+    size_t rows_ready = 0;  // rows with memory behind them
+    size_t grow = 0;        // rows added at a time, 0: all memory at once
+    bool publisher = false; // this process fills the file
+    bool agent = false;     // this process maps rows of the file
+    bool cow = false;       // agent that maps the whole file, writable and private
+    // device memory composed with the virtual memory interface of the backend (LLAMA_KV_VMM)
+    bool vmm = false;
+    bool demand = false;    // LLAMA_KV_VMM=2: private, follows the rows in use, neither published nor imported
+    bool batch = false;     // LLAMA_KV_VMM_BATCH=1: one access setting per range and one wait per step
+    bool merge = false;     // LLAMA_KV_VMM_BATCH=2: also one allocation per tensor for the published rows
+    int device = 0;
+    std::vector<size_t> granules;       // per tensor: leading granules with memory
+    std::vector<std::vector<int>> fds;  // publisher, per tensor: the handle of every granule
+};
+
+static const size_t llama_kv_vmm_granule = 2u << 20;
+
+// the device-memory functions of the CUDA backend, when it has them
+struct llama_kv_vmm_api {
+    void * (*reserve)(int, size_t);
+    bool (*map_new)(int, void *, size_t, int *);
+    bool (*map_fd)(int, void *, size_t, int);
+    bool (*copy_fd)(int, void *, size_t, int, size_t);
+    bool (*protect)(int, void *, size_t);
+    void (*zero)(int, void *, size_t);
+    ggml_backend_buffer_t (*buffer)(int, void *, size_t);
+    ggml_backend_buffer_type_t (*buffer_type)(int);
+    int (*device_count)(void);
+    bool (*map_fds)(int, void *, size_t, const int *, size_t);
+    bool (*map_private)(int, void *, size_t);
+    bool (*copy_fds)(int, void * const *, size_t, const int *, const size_t *, size_t);
+    bool (*protect_ranges)(int, void * const *, const size_t *, size_t);
+    void (*wait)(int);
+    bool (*merge)(int, void * const *, const size_t *, size_t, size_t, int *);
+    void (*zero_ranges)(int, void * const *, const size_t *, size_t);
+};
+
+static const llama_kv_vmm_api * llama_kv_vmm() {
+    static llama_kv_vmm_api api;
+    static bool resolved = false;
+    static bool complete = false;
+    if (!resolved) {
+        resolved = true;
+        api.reserve      = (void * (*)(int, size_t)) dlsym(RTLD_DEFAULT, "ggml_backend_cuda_vmm_reserve");
+        api.map_new      = (bool (*)(int, void *, size_t, int *)) dlsym(RTLD_DEFAULT, "ggml_backend_cuda_vmm_map_new");
+        api.map_fd       = (bool (*)(int, void *, size_t, int)) dlsym(RTLD_DEFAULT, "ggml_backend_cuda_vmm_map_fd");
+        api.copy_fd      = (bool (*)(int, void *, size_t, int, size_t)) dlsym(RTLD_DEFAULT, "ggml_backend_cuda_vmm_copy_fd");
+        api.protect      = (bool (*)(int, void *, size_t)) dlsym(RTLD_DEFAULT, "ggml_backend_cuda_vmm_protect");
+        api.zero         = (void (*)(int, void *, size_t)) dlsym(RTLD_DEFAULT, "ggml_backend_cuda_vmm_zero");
+        api.buffer       = (ggml_backend_buffer_t (*)(int, void *, size_t)) dlsym(RTLD_DEFAULT, "ggml_backend_cuda_vmm_buffer");
+        api.buffer_type  = (ggml_backend_buffer_type_t (*)(int)) dlsym(RTLD_DEFAULT, "ggml_backend_cuda_buffer_type");
+        api.device_count = (int (*)(void)) dlsym(RTLD_DEFAULT, "ggml_backend_cuda_get_device_count");
+        api.map_fds        = (bool (*)(int, void *, size_t, const int *, size_t)) dlsym(RTLD_DEFAULT, "ggml_backend_cuda_vmm_map_fds");
+        api.map_private    = (bool (*)(int, void *, size_t)) dlsym(RTLD_DEFAULT, "ggml_backend_cuda_vmm_map_private");
+        api.copy_fds       = (bool (*)(int, void * const *, size_t, const int *, const size_t *, size_t)) dlsym(RTLD_DEFAULT, "ggml_backend_cuda_vmm_copy_fds");
+        api.protect_ranges = (bool (*)(int, void * const *, const size_t *, size_t)) dlsym(RTLD_DEFAULT, "ggml_backend_cuda_vmm_protect_ranges");
+        api.wait           = (void (*)(int)) dlsym(RTLD_DEFAULT, "ggml_backend_cuda_vmm_wait");
+        api.zero_ranges    = (void (*)(int, void * const *, const size_t *, size_t)) dlsym(RTLD_DEFAULT, "ggml_backend_cuda_vmm_zero_ranges");
+        api.merge          = (bool (*)(int, void * const *, const size_t *, size_t, size_t, int *)) dlsym(RTLD_DEFAULT, "ggml_backend_cuda_vmm_merge");
+        complete = api.reserve && api.map_new && api.map_fd && api.copy_fd && api.protect && api.zero && api.buffer && api.buffer_type && api.device_count &&
+                   api.map_fds && api.map_private && api.copy_fds && api.protect_ranges && api.wait && api.merge && api.zero_ranges;
+    }
+    return complete ? &api : nullptr;
+}
+
+// Maps granules of device memory until the rows below `rows` have memory.
+static void llama_kv_vmm_grow(llama_kv_host & host, size_t rows) {
+    const llama_kv_vmm_api * api = llama_kv_vmm();
+    const size_t granule = llama_kv_vmm_granule;
+    if (host.batch && !host.publisher) {
+        // memory that is not published: one allocation per tensor for all the granules that are added
+        bool mapped = false;
+        for (size_t i = 0; i < host.tensors.size(); ++i) {
+            const auto & t = host.tensors[i];
+            const size_t need = std::min((std::min(rows, t.rows) * t.row + granule - 1) / granule, t.size / granule);
+            if (need <= host.granules[i]) {
+                continue;
+            }
+            if (!api->map_private(host.device, host.base + t.offset + host.granules[i] * granule, (need - host.granules[i]) * granule)) {
+                throw std::runtime_error("kv cache: cannot map device memory");
+            }
+            host.granules[i] = need;
+            mapped = true;
+        }
+        if (mapped) {
+            api->wait(host.device);
+        }
+        return;
+    }
+    for (size_t i = 0; i < host.tensors.size(); ++i) {
+        const auto & t = host.tensors[i];
+        const size_t need = std::min((std::min(rows, t.rows) * t.row + granule - 1) / granule, t.size / granule);
+        for (size_t g = host.granules[i]; g < need; ++g) {
+            int fd = -1;
+            if (!api->map_new(host.device, host.base + t.offset + g * granule, granule, host.publisher ? &fd : nullptr)) {
+                throw std::runtime_error("kv cache: cannot map device memory");
+            }
+            if (host.publisher) {
+                host.fds[i].push_back(fd);
+            }
+        }
+        host.granules[i] = std::max(host.granules[i], need);
+    }
+}
+
+static std::unordered_map<ggml_backend_buffer_t, llama_kv_host> & llama_kv_hosts() {
+    static std::unordered_map<ggml_backend_buffer_t, llama_kv_host> hosts;
+    return hosts;
+}
+
+static llama_kv_host * llama_kv_host_of(ggml_backend_buffer_t buf) {
+    const auto it = llama_kv_hosts().find(buf);
+    return it == llama_kv_hosts().end() ? nullptr : &it->second;
+}
+
+static const size_t llama_kv_host_page = 4096;
+
+// Two steps can be left out to measure what they are worth:
+// LLAMA_KV_TOUCH=0     no CPU read of the rows that are mapped; the device faults on their entries.
+// LLAMA_KV_POPULATE=0  an agent puts no memory behind its rows before the device writes them; the device faults it in.
+static bool llama_kv_step_off(const char * name) {
+    const char * value = getenv(name);
+    return value != nullptr && value[0] == '0';
+}
+
+// Puts memory behind the rows below `rows`, before the device writes them.
+static void llama_kv_host_grow(ggml_backend_buffer_t buf, size_t rows) {
+    llama_kv_host * host = llama_kv_host_of(buf);
+    if (host == nullptr || host->grow == 0 || rows <= host->rows_ready) {
+        return;
+    }
+    const size_t page = llama_kv_host_page;
+    const size_t target = (rows + host->grow - 1) / host->grow * host->grow;
+    if (host->vmm) {
+        llama_kv_vmm_grow(*host, target);
+        host->rows_ready = target;
+        return;
+    }
+    for (const auto & t : host->tensors) {
+        const size_t begin = host->rows_ready * t.row / page * page;
+        const size_t end = std::min((std::min(target, t.rows) * t.row + page - 1) / page * page, t.size);
+        if (end > begin && !(host->agent && llama_kv_step_off("LLAMA_KV_POPULATE")) &&
+            madvise(host->base + t.offset + begin, end - begin, MADV_POPULATE_WRITE) != 0) {
+            throw std::runtime_error("kv cache: cannot grow the host mapping");
+        }
+    }
+    host->rows_ready = target;
+}
+
+// The rows below `rows` of a publisher stay as they are from here on. Returns false when the cache is not a publisher.
+static bool llama_kv_host_freeze(ggml_backend_buffer_t buf, size_t rows) {
+    llama_kv_host * host = llama_kv_host_of(buf);
+    if (host == nullptr || !host->publisher) {
+        return false;
+    }
+    if (rows <= host->rows_mapped) {
+        return true;
+    }
+    if (host->vmm) {
+        // the granules that the rows fill become read-only here; their handles, and the handle of the
+        // granule the rows end in, go to LLAMA_KV_VMM_EXPORT for the processes this one starts
+        const size_t granule = llama_kv_vmm_granule;
+        std::string exported = std::to_string(rows);
+        if (host->merge) {
+            // the allocations that the rows fill become one allocation per tensor, which an agent imports with
+            // one handle; a cache that does this publishes once
+            std::vector<void *> addrs;
+            std::vector<size_t> counts;
+            for (const auto & t : host->tensors) {
+                addrs.push_back(host->base + t.offset);
+                counts.push_back(std::min(rows, t.rows) * t.row / granule);
+            }
+            std::vector<int> merged(addrs.size(), -1);
+            if (!llama_kv_vmm()->merge(host->device, addrs.data(), counts.data(), addrs.size(), granule, merged.data())) {
+                throw std::runtime_error("kv cache: cannot freeze the published rows");
+            }
+            for (size_t i = 0; i < host->tensors.size(); ++i) {
+                const auto & t = host->tensors[i];
+                const size_t filled = std::min(rows, t.rows) * t.row;
+                for (size_t g = 0; g < counts[i]; ++g) {
+                    close(host->fds[i][g]);
+                }
+                if (counts[i] > 0) {
+                    (void) fcntl(merged[i], F_SETFD, 0);
+                    exported += " " + std::to_string(merged[i]);
+                }
+                if (filled % granule != 0) {
+                    (void) fcntl(host->fds[i][counts[i]], F_SETFD, 0);
+                    exported += " " + std::to_string(host->fds[i][counts[i]]);
+                }
+            }
+            setenv("LLAMA_KV_VMM_EXPORT", exported.c_str(), 1);
+            host->rows_mapped = rows;
+            return true;
+        }
+        if (host->batch) {
+            std::vector<void *> addrs;
+            std::vector<size_t> sizes;
+            for (const auto & t : host->tensors) {
+                addrs.push_back(host->base + t.offset);
+                sizes.push_back(std::min(rows, t.rows) * t.row / granule * granule);
+            }
+            if (!llama_kv_vmm()->protect_ranges(host->device, addrs.data(), sizes.data(), addrs.size())) {
+                throw std::runtime_error("kv cache: cannot freeze the published rows");
+            }
+        }
+        for (size_t i = 0; i < host->tensors.size(); ++i) {
+            const auto & t = host->tensors[i];
+            const size_t filled = std::min(rows, t.rows) * t.row;
+            const size_t whole = filled / granule;
+            if (!host->batch && whole > 0 && !llama_kv_vmm()->protect(host->device, host->base + t.offset, whole * granule)) {
+                throw std::runtime_error("kv cache: cannot freeze the published rows");
+            }
+            for (size_t g = 0; g < whole + (filled % granule != 0 ? 1 : 0); ++g) {
+                (void) fcntl(host->fds[i][g], F_SETFD, 0);
+                exported += " " + std::to_string(host->fds[i][g]);
+            }
+        }
+        setenv("LLAMA_KV_VMM_EXPORT", exported.c_str(), 1);
+        host->rows_mapped = rows;
+        return true;
+    }
+    for (const auto & t : host->tensors) {
+        const size_t whole = std::min(rows, t.rows) * t.row / llama_kv_host_page * llama_kv_host_page;
+        if (whole > 0 && mprotect(host->base + t.offset, whole, PROT_READ) != 0) {
+            throw std::runtime_error("kv cache: cannot freeze the published rows");
+        }
+    }
+    host->rows_mapped = rows;
+    return true;
+}
+
+// Zeroes the rows that this process owns. The rows of the file belong to every process that maps them.
+static void llama_kv_host_clear(llama_kv_host & host) {
+    if (host.cow) {
+        return;
+    }
+    if (host.vmm && host.batch) {
+        std::vector<void *> addrs;
+        std::vector<size_t> sizes;
+        for (size_t i = 0; i < host.tensors.size(); ++i) {
+            const auto & t = host.tensors[i];
+            const size_t first = std::min(host.rows_mapped, t.rows) * t.row;
+            const size_t last = host.granules[i] * llama_kv_vmm_granule;
+            if (last > first) {
+                addrs.push_back(host.base + t.offset + first);
+                sizes.push_back(last - first);
+            }
+        }
+        llama_kv_vmm()->zero_ranges(host.device, addrs.data(), sizes.data(), addrs.size());
+        return;
+    }
+    if (host.vmm) {
+        for (size_t i = 0; i < host.tensors.size(); ++i) {
+            const auto & t = host.tensors[i];
+            const size_t first = std::min(host.rows_mapped, t.rows) * t.row;
+            const size_t last = host.granules[i] * llama_kv_vmm_granule;
+            if (last > first) {
+                llama_kv_vmm()->zero(host.device, host.base + t.offset + first, last - first);
+            }
+        }
+        return;
+    }
+    for (const auto & t : host.tensors) {
+        const size_t first = std::min(host.rows_mapped, t.rows) * t.row;
+        const size_t last = std::min((std::min(host.rows_ready, t.rows) * t.row + llama_kv_host_page - 1) / llama_kv_host_page * llama_kv_host_page, t.size);
+        if (last > first) {
+            memset(host.base + t.offset + first, 0, last - first);
+        }
+    }
+}
+
+// The device cannot set the accessed flag of a page-table entry and faults on every entry without it; a CPU read sets it.
+static void llama_kv_host_touch(const std::vector<std::pair<const char *, size_t>> & ranges) {
+    size_t n_pages = 0;
+    for (const auto & [_, size] : ranges) {
+        n_pages += size / llama_kv_host_page;
+    }
+    const unsigned n_threads = std::max(1u, std::min(12u, std::thread::hardware_concurrency()));
+    std::vector<std::thread> workers;
+    for (unsigned t = 0; t < n_threads; t++) {
+        workers.emplace_back([&ranges, n_pages, n_threads, t]() {
+            const size_t first = n_pages * t / n_threads;
+            const size_t last = n_pages * (t + 1) / n_threads;
+            size_t skipped = 0;
+            for (const auto & [ptr, size] : ranges) {
+                const size_t pages = size / llama_kv_host_page;
+                const volatile char * view = (const volatile char *) ptr;
+                for (size_t i = std::max(first, skipped); i < std::min(last, skipped + pages); i++) {
+                    (void) view[(i - skipped) * llama_kv_host_page];
+                }
+                skipped += pages;
+            }
+        });
+    }
+    for (auto & worker : workers) {
+        worker.join();
+    }
+}
+
+// LLAMA_KV_VMM=1: the cache is device memory in 2 MiB allocations that other processes can map.
+// LLAMA_KV_VMM_BATCH=1 with the above: the access of the allocations of a tensor is set in one call, the
+//                          allocations that a prefix ends in are copied with one wait for the device, and
+//                          memory that is not published is one allocation per tensor and step.
+// LLAMA_KV_VMM_BATCH=2:    the same, and a publisher copies the rows it publishes into one allocation per
+//                          tensor, so that an agent imports one handle per tensor.
+// LLAMA_KV_VMM_IMPORT="ROWS FD FD ...": agent, the leading ROWS rows are allocations of a publisher, mapped read-only.
+// Returns nullptr when the backend cannot do it.
+static ggml_backend_buffer_t llama_kv_alloc_vmm(ggml_context * ctx, ggml_backend_buffer_type_t buft, bool rows_are_cells) {
+    const llama_kv_vmm_api * api = llama_kv_vmm();
+    if (api == nullptr) {
+        return nullptr;
+    }
+    int device = -1;
+    for (int i = 0; i < api->device_count(); ++i) {
+        if (api->buffer_type(i) == buft) {
+            device = i;
+        }
+    }
+    if (device < 0) {
+        return nullptr;
+    }
+
+    const size_t granule = llama_kv_vmm_granule;
+    llama_kv_host host;
+    host.vmm = true;
+    host.device = device;
+    std::vector<ggml_tensor *> placed;
+    size_t total = 0;
+    size_t max_rows = 0;
+    bool one_stream = true;
+    for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+        if (t->view_src != nullptr) {
+            continue;
+        }
+        const size_t size = (ggml_backend_buft_get_alloc_size(buft, t) + granule - 1) / granule * granule;
+        placed.push_back(t);
+        host.tensors.push_back({ total, ggml_row_size(t->type, t->ne[0]), (size_t) t->ne[1], size });
+        total += size;
