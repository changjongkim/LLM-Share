+    if (host.grow == 0) {
+        llama_kv_vmm_grow(host, max_rows);
+        host.rows_ready = max_rows;
+    } else {
+        host.rows_ready = host.rows_mapped;
+    }
+
+    ggml_backend_buffer_t buf = api->buffer(device, host.base, total);
+    if (buf == nullptr) {
+        throw std::runtime_error("kv cache: the device refused the composed range");
+    }
+    for (size_t i = 0; i < placed.size(); ++i) {
+        if (ggml_backend_tensor_alloc(buf, placed[i], host.base + host.tensors[i].offset) != GGML_STATUS_SUCCESS) {
+            throw std::runtime_error("kv cache: cannot place a tensor");
+        }
+    }
+    for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+        if (t->view_src != nullptr && ggml_backend_view_init(t) != GGML_STATUS_SUCCESS) {
+            throw std::runtime_error("kv cache: cannot initialize a view");
+        }
+    }
+    LLAMA_LOG_WARN("%s: kv cache in composed device memory: mode = %s, %.2f MiB, %.2f MiB shared read-only, grow = %zu rows\n", __func__,
+            host.agent ? "prefix" : "publisher", total / 1048576.0, shared_bytes / 1048576.0, host.grow);
+    llama_kv_hosts()[buf] = std::move(host);
+    return buf;
+}
+
+// LLAMA_KV_HOST=anon: private memory.
+// LLAMA_KV_HOST=PATH: publisher, the cache is the file PATH.INDEX.
+// LLAMA_KV_HOST=PATH LLAMA_KV_PREFIX=ROWS: agent, the first ROWS rows are a read-only mapping of the file, the rest is private.
+// LLAMA_KV_COW=1 with the above: agent, the whole file as a writable private mapping (copy-on-write); 2: the same without the CPU read of the prefix.
+// LLAMA_KV_GROW=ROWS: memory follows the rows in use, ROWS at a time.
+// Returns nullptr when the mode is off or the device cannot do it.
+static ggml_backend_buffer_t llama_kv_alloc_host(ggml_context * ctx, ggml_backend_buffer_type_t buft, int index, bool rows_are_cells) {
+    const char * vmm = getenv("LLAMA_KV_VMM");
+    if (vmm != nullptr && (vmm[0] == '1' || vmm[0] == '2')) {
+        return llama_kv_alloc_vmm(ctx, buft, rows_are_cells);
+    }
+    const char * mode = getenv("LLAMA_KV_HOST");
+    if (mode == nullptr || mode[0] == '\0') {
+        return nullptr;
+    }
+    ggml_backend_dev_t dev = ggml_backend_buft_get_device(buft);
+    if (dev == nullptr) {
+        return nullptr;
+    }
+    ggml_backend_dev_props props;
+    ggml_backend_dev_get_props(dev, &props);
+    if (!props.caps.buffer_from_host_ptr || buft != ggml_backend_dev_buffer_type(dev)) {
+        return nullptr;
+    }
+
+    const size_t huge = 2u << 20;
+    const size_t page = llama_kv_host_page;
+    const auto round_up = [](size_t value, size_t unit) { return (value + unit - 1) / unit * unit; };
+
+    llama_kv_host host;
+    std::vector<ggml_tensor *> placed;
+    size_t total = 0;
+    size_t max_tensor = 0;
+    size_t max_rows = 0;
+    bool one_stream = true;
+    for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+        if (t->view_src != nullptr) {
+            continue;
+        }
+        const size_t size = ggml_backend_buft_get_alloc_size(buft, t);
+        placed.push_back(t);
+        host.tensors.push_back({ total, ggml_row_size(t->type, t->ne[0]), (size_t) t->ne[1], round_up(size, huge) });
+        total += round_up(size, huge);
+        max_tensor = std::max(max_tensor, size);
+        max_rows = std::max(max_rows, (size_t) t->ne[1]);
+        one_stream = one_stream && t->ne[2] == 1;
+    }
+    if (total == 0) {
+        return nullptr;
+    }
+
+    const bool anonymous = strcmp(mode, "anon") == 0;
+    const char * prefix_env = getenv("LLAMA_KV_PREFIX");
+    const char * cow_env = getenv("LLAMA_KV_COW");
+    const char * grow_env = getenv("LLAMA_KV_GROW");
+    host.rows_mapped = !anonymous && prefix_env != nullptr ? std::min<size_t>(strtoull(prefix_env, nullptr, 10), max_rows) : 0;
+    host.agent = host.rows_mapped > 0;
+    host.publisher = !anonymous && !host.agent;
+    host.cow = host.agent && cow_env != nullptr && (cow_env[0] == '1' || cow_env[0] == '2');
+    const bool touch = !(host.cow && cow_env[0] == '2');
+    host.path = anonymous ? "" : std::string(mode) + "." + std::to_string(index);
+    host.grow = !host.cow && grow_env != nullptr ? strtoull(grow_env, nullptr, 10) : 0;
+
+    // rows must be cells: with a transposed value tensor or several streams a prefix is not a leading range
+    if (host.agent && !(rows_are_cells && one_stream)) {
+        throw std::runtime_error("kv cache: a prefix of this cache cannot be mapped");
+    }
+
+    void * reserved = mmap(nullptr, total + huge, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+    if (reserved == MAP_FAILED) {
+        throw std::runtime_error("kv cache: cannot reserve address space");
+    }
+    char * base = (char *) (((uintptr_t) reserved + huge - 1) & ~(uintptr_t) (huge - 1));
+    host.base = base;
+
+    if (host.cow) {
+        const int fd = open(host.path.c_str(), O_RDONLY);
+        if (fd < 0 || mmap(base, total, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_FIXED | MAP_NORESERVE, fd, 0) == MAP_FAILED) {
+            throw std::runtime_error("kv cache: cannot map " + host.path);
+        }
+        close(fd);
+    } else if (host.publisher) {
+        const int fd = open(host.path.c_str(), O_RDWR | O_CREAT | O_TRUNC, 0600);
+        if (fd < 0 || ftruncate(fd, (off_t) total) != 0) {
+            throw std::runtime_error("kv cache: cannot create " + host.path);
+        }
+        if (mmap(base, total, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_FIXED, fd, 0) == MAP_FAILED) {
+            throw std::runtime_error("kv cache: cannot map " + host.path);
+        }
+        close(fd);
+    } else {
+        if (mmap(base, total, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED | MAP_NORESERVE, -1, 0) == MAP_FAILED) {
+            throw std::runtime_error("kv cache: cannot map private memory");
+        }
+        // a cache that grows takes small pages, so that its memory is the rows in use
+        (void) madvise(base, total, host.grow > 0 ? MADV_NOHUGEPAGE : MADV_HUGEPAGE);
+    }
+    if (!host.cow && !host.agent && host.grow == 0) {
+        // writable entries, so that the device never faults when it writes the cache
+        if (madvise(base, total, MADV_POPULATE_WRITE) != 0) {
+            throw std::runtime_error("kv cache: cannot populate the mapping");
+        }
+    }
+
+    size_t shared_bytes = 0;
+    std::vector<std::pair<const char *, size_t>> mapped;
+    if (host.agent && !host.cow) {
+        const int fd = open(host.path.c_str(), O_RDONLY);
+        if (fd < 0) {
+            throw std::runtime_error("kv cache: cannot open " + host.path);
+        }
+        for (const auto & t : host.tensors) {
+            const size_t filled = std::min(host.rows_mapped, t.rows) * t.row;
+            const size_t whole = filled / page * page;
+            if (whole > 0) {
+                if (mmap(base + t.offset, whole, PROT_READ, MAP_PRIVATE | MAP_FIXED | MAP_NORESERVE, fd, (off_t) t.offset) == MAP_FAILED) {
+                    throw std::runtime_error("kv cache: cannot map the prefix");
+                }
+                mapped.emplace_back(base + t.offset, whole);
+                shared_bytes += whole;
+            }
+            if (filled > whole) {
+                // the last, partly filled page of the prefix is copied
+                if (pread(fd, base + t.offset + whole, filled - whole, (off_t) (t.offset + whole)) != (ssize_t) (filled - whole)) {
+                    throw std::runtime_error("kv cache: cannot read the prefix");
+                }
+            }
+            if (host.grow == 0 && madvise(base + t.offset + whole, t.size - whole, MADV_POPULATE_WRITE) != 0) {
+                throw std::runtime_error("kv cache: cannot populate the mapping");
+            }
+        }
+        close(fd);
+    }
+    if (host.cow && touch) {
+        for (const auto & t : host.tensors) {
+            mapped.emplace_back(base + t.offset, std::min(host.rows_mapped, t.rows) * t.row);
+        }
+    }
+    if (!llama_kv_step_off("LLAMA_KV_TOUCH")) {
+        llama_kv_host_touch(mapped);
+    }
+    host.rows_ready = host.grow > 0 ? host.rows_mapped : max_rows;
+
+    // the entries that need a CPU read have it; a read of the rest would put memory behind rows that are not in use
+    const char * preread_env = getenv("GGML_CUDA_HOST_PTR_PREREAD");
+    const std::string preread = preread_env != nullptr ? preread_env : "";
+    setenv("GGML_CUDA_HOST_PTR_PREREAD", "0", 1);
+    ggml_backend_buffer_t buf = ggml_backend_dev_buffer_from_host_ptr(dev, base, total, max_tensor);
+    if (preread_env != nullptr) {
+        setenv("GGML_CUDA_HOST_PTR_PREREAD", preread.c_str(), 1);
+    } else {
+        unsetenv("GGML_CUDA_HOST_PTR_PREREAD");
+    }
+    if (buf == nullptr) {
+        throw std::runtime_error("kv cache: the device refused the host mapping");
+    }
+    for (size_t i = 0; i < placed.size(); ++i) {
+        if (ggml_backend_tensor_alloc(buf, placed[i], base + host.tensors[i].offset) != GGML_STATUS_SUCCESS) {
+            throw std::runtime_error("kv cache: cannot place a tensor");
+        }
+    }
+    for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+        if (t->view_src != nullptr && ggml_backend_view_init(t) != GGML_STATUS_SUCCESS) {
+            throw std::runtime_error("kv cache: cannot initialize a view");
+        }
+    }
+    LLAMA_LOG_WARN("%s: kv cache in host memory: mode = %s, %.2f MiB, %.2f MiB shared read-only from %s, grow = %zu rows\n", __func__,
+            anonymous ? "anon" : (host.cow ? "cow" : (host.agent ? "prefix" : "file")), total / 1048576.0, shared_bytes / 1048576.0,
+            host.path.empty() ? "-" : host.path.c_str(), host.grow);
+    llama_kv_hosts()[buf] = std::move(host);
+    return buf;
+}
