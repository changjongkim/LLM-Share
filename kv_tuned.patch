+                    }
+                    end_ms += ms_since(mark);
+                    ends.push_back(last);
+                    end_fds.push_back((int) numbers[next++]);
+                    end_bytes.push_back(filled % granule);
+                    host.granules[i] = whole + 1;
+                }
+            }
+            const auto mark = std::chrono::steady_clock::now();
+            if (!api->copy_fds(device, ends.data(), granule, end_fds.data(), end_bytes.data(), ends.size())) {
+                throw std::runtime_error("kv cache: cannot copy the end of the prefix");
+            }
+            api->wait(device);
+            LLAMA_LOG_WARN("%s: kv cache attach: %.0f MiB of published allocations mapped in %.1f ms, %zu ends allocated in %.1f ms and copied in %.1f ms\n", __func__,
+                    shared_bytes / 1048576.0, map_ms, ends.size(), end_ms, ms_since(mark));
+        }
+        for (size_t i = 0; !host.batch && i < host.tensors.size(); ++i) {
+            const auto & t = host.tensors[i];
+            const size_t filled = std::min(host.rows_mapped, t.rows) * t.row;
+            const size_t whole = filled / granule;
+            if (next + whole + (filled % granule != 0 ? 1 : 0) > numbers.size()) {
+                throw std::runtime_error("kv cache: LLAMA_KV_VMM_IMPORT names too few allocations");
+            }
+            for (size_t g = 0; g < whole; ++g) {
+                if (!api->map_fd(device, host.base + t.offset + g * granule, granule, (int) numbers[next++])) {
+                    throw std::runtime_error("kv cache: cannot map a published allocation");
+                }
+            }
+            host.granules[i] = whole;
+            shared_bytes += whole * granule;
+            if (filled % granule != 0) {
+                // the allocation that the prefix ends in is copied as far as the prefix goes
+                char * last = host.base + t.offset + whole * granule;
+                if (!api->map_new(device, last, granule, nullptr) ||
+                    !api->copy_fd(device, last, granule, (int) numbers[next++], filled % granule)) {
