+// The rows of a published cache are in its file, a state file carries none of them.
+static void llama_kv_write_rows(llama_io_write_i & io, ggml_tensor * t, size_t offset, size_t size) {
+    const llama_kv_host * host = llama_kv_host_of(t->buffer);
+    if (host != nullptr && host->agent) {
+        throw std::runtime_error("kv cache: an agent of a published cache cannot save its state");
+    }
+    if (host == nullptr || !host->publisher) {
+        io.write_tensor(t, offset, size);
+    }
+}
+
+static void llama_kv_read_rows(llama_io_read_i & io, ggml_tensor * t, size_t offset, size_t size) {
+    const llama_kv_host * host = llama_kv_host_of(t->buffer);
+    if (host == nullptr || (host->path.empty() && !host->vmm)) {
+        io.read_tensor(t, offset, size);
+        return;
+    }
+    if (host->demand) {
+        // a private cache copies the rows of the state, once it has memory for them
+        llama_kv_host * mine = llama_kv_host_of(t->buffer);
+        const size_t row = ggml_row_size(t->type, t->ne[0]);
+        const size_t rows = (offset + size + row - 1) / row;
+        if (rows > mine->rows_ready) {
+            const size_t target = mine->grow > 0 ? (rows + mine->grow - 1) / mine->grow * mine->grow : rows;
+            llama_kv_vmm_grow(*mine, target);
+            mine->rows_ready = target;
+        }
+        io.read_tensor(t, offset, size);
+        return;
+    }
+    if (host->publisher) {
+        throw std::runtime_error("kv cache: a publisher starts from an empty cache");
+    }
+    if (host->vmm) {
+        // the published rows are mapped or copied; a state names no others
+        if (offset + size > host->rows_mapped * ggml_row_size(t->type, t->ne[0])) {
+            throw std::runtime_error("kv cache: the state names rows that were not published");
+        }
+        return;
+    }
+    // the mapped rows are in place; rows after them come from the file
+    const size_t mapped = host->rows_mapped * ggml_row_size(t->type, t->ne[0]);
+    if (offset + size <= mapped || host->cow) {
+        return;
+    }
+    const size_t from = std::max(offset, mapped);
+    char * dst = (char *) t->data + from;
+    const int fd = open(host->path.c_str(), O_RDONLY);
+    const bool ok = fd >= 0 && pread(fd, dst, offset + size - from, (off_t) (dst - host->base)) == (ssize_t) (offset + size - from);
+    if (fd >= 0) {
+        close(fd);
+    }
+    if (!ok) {
+        throw std::runtime_error("kv cache: cannot read rows of " + host->path);
+    }
+}
