+static ggml_backend_buffer_t ggml_backend_cuda_device_buffer_from_host_ptr(ggml_backend_dev_t dev, void * ptr, size_t size, size_t max_tensor_size) {
+    ggml_backend_cuda_device_context * ctx = (ggml_backend_cuda_device_context *)dev->context;
+
+    // A CPU access marks a page-table entry accessed, which the GPU cannot do
+    // itself here; without it the first kernel faults on every page.
+    const char * preread = getenv("GGML_CUDA_HOST_PTR_PREREAD");
+    if (preread == nullptr || preread[0] != '0') {
+        const unsigned n_threads = std::max(1u, std::min(12u, std::thread::hardware_concurrency()));
+        const size_t page = 4096;
+        const size_t n_pages = (size + page - 1) / page;
+        const volatile char * view = (const volatile char *) ptr;
+        std::vector<std::thread> workers;
+        for (unsigned t = 0; t < n_threads; t++) {
+            workers.emplace_back([=]() {
+                for (size_t i = n_pages * t / n_threads; i < n_pages * (t + 1) / n_threads; i++) {
+                    const size_t offset = i * page;
+                    (void) view[offset < size ? offset : size - 1];
+                }
+            });
+        }
+        for (auto & worker : workers) {
+            worker.join();
+        }
+    }
+
+    ggml_backend_cuda_buffer_context * buf_ctx = new ggml_backend_cuda_buffer_context(ctx->device, ptr, true);
+    return ggml_backend_buffer_init(ggml_backend_cuda_buffer_type(ctx->device), ggml_backend_cuda_buffer_interface, buf_ctx, size);
+
+    GGML_UNUSED(max_tensor_size);
+}
